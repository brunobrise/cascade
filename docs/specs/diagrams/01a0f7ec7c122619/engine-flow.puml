@startuml
skinparam backgroundColor transparent
skinparam handwritten false
skinparam defaultFontName Helvetica
skinparam shadowing false

skinparam state {
    BorderColor #2D3748
    FontColor #1A202C
    BackgroundColor #EDF2F7
    ArrowColor #4A5568
}

[*] --> QueryWindows : Window Server Scan
QueryWindows --> FilterStandard : Filter AXStandardWindow & Non-Minimized

state TriggerBranch <<choice>>
FilterStandard --> TriggerBranch : Evaluate Trigger Source

TriggerBranch --> ManualSort : Manual Trigger (Hotkey / Menu)
TriggerBranch --> PreserveOrder : Event Trigger (New / Resize / Min / Close)

ManualSort --> LayoutCalculation : Apply User Order (MRU/Spatial/Alpha)
PreserveOrder --> LayoutCalculation : Preserve Existing Sequence (Just Change Size)

state LayoutCalculation {
    [*] --> CheckCount
    CheckCount --> OpposedEdges : N = 2 (98% Area)
    CheckCount --> DiagonalCascade : N >= 3 (Invariant Tabs)
}

OpposedEdges --> CalculateTargetBounds : Set Opposing Bezel Margins
DiagonalCascade --> CalculateTargetBounds : Set Diagonal Invariant Offsets

CalculateTargetBounds --> ApplyGeometry : AXUIElementSetAttributeValue (pos, size)

state RestackBranch <<choice>>
ApplyGeometry --> RestackBranch : Check Event Type

RestackBranch --> RestackZ : Manual & Restack Enabled (kAXRaiseAction)
RestackBranch --> Complete : Automatic Event (Skip Restack to Keep Focus)

RestackZ --> Complete
Complete --> [*]
@enduml
